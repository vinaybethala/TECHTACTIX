# .env.example
# Copy this file to .env.local and fill in the values before deploying

# Database URL (Required)
# If using Prisma with SQLite locally, this is already set in schema.prisma
# If deploying to Vercel/Supabase, change provider to 'postgresql' in schema.prisma
# and provide the Postgres connection string here.
DATABASE_URL="file:./dev.db"

# Email Credentials for Nodemailer (Required for sending registration confirmations)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"

# Supabase (Optional, if using Supabase client instead of Prisma)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
